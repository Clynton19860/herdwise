# Copy to /etc/herdwise/gateway.env — chmod 600, owned by root.
# Contains a database password; it must not be world-readable.

# The port tags dial into. Must match what the tags are configured with, and
# must be open in both the cloud firewall and ufw.
GATEWAY_PORT=5100

# Supabase gives you this under Project Settings -> Database -> Connection string.
# Use the session-pooler URI, and the service role — the gateway writes telemetry
# for every device and is not acting for any signed-in user.
DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=require

# How often to check command_queue for work. Tags only receive commands while
# their socket is open, so this is the whole latency budget for "locate now".
COMMAND_POLL_MS=2000

# Device clock interpretation. The vendor doc says the timestamp is "currently
# non-UTC ... can be UTC" and Harare is UTC+2 — a wrong guess shifts every track
# by two hours. Confirm with the supplier before trusting this.
DEVICE_TIME_UTC=true
