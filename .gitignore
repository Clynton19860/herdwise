# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries no values, and is the only record of what a deployment
# needs — .env.local never leaves the machine it is on.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state (project ref, pooler URL)
supabase/.temp/

# Gateway dependencies
gateway/node_modules/

# Database dumps — may contain real owner and position data
backups/

# Real device registration — an IMEI is a vendor-platform login name, and a
# test paddock is usually a real address. Use real-device.sql.example.
supabase/real-device.sql
