# Herdwise — every variable the web application reads.
#
# Copy to .env.local for development. On Vercel, set them in the project's
# Environment Variables, because .env.local is gitignored and never travels with
# the repository.
#
# The gateway is a separate deployment with its own file — see
# gateway/deploy/gateway.env.example.

# ─────────────────────────────────────────────────────── required

# Supabase Postgres, through the transaction pooler on 6543. This is the
# browser-facing role: read-only except for the tables it was deliberately
# granted, so a compromised connection cannot change anybody's role or ward.
DATABASE_URL=postgres://herdwise_web.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Used only to send and verify the six-digit sign-in code, through Supabase
# Auth's own mailer. The anon key is public by design — it ships in the browser
# bundle — and since migration 0008 it can no longer read any table.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Signs the session cookie. At least 32 characters.
#
# Without it, sign-in returns a 500 — the pages and the login screen render, and
# submitting the form fails. Rotating it signs everybody out immediately, which
# is the emergency lever if a session is ever believed stolen.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<48 random bytes>

# ─────────────────────────────────────────────────────── optional

# Enables the Ask Herdwise assistant. Absent, the launcher is hidden rather than
# broken — no dead button appears. The endpoint costs money per call, so it is
# behind a session and a rate limit.
ANTHROPIC_API_KEY=

# Caps on the assistant endpoint, per caller — the only endpoint with a
# per-use cost. Leave both unset unless you have a reason: the defaults allow
# ten questions a minute, which is far above normal use and far below what a
# stuck retry loop achieves.
#
# Note the limiter holds its counters in process memory, so on a serverless
# platform each instance keeps its own and the effective cap is higher than the
# number set here. For a hard ceiling, set a spend limit on the Anthropic
# account — that is enforced by them rather than by hopeful code here.
# CHAT_RATE_LIMIT=10
# CHAT_RATE_WINDOW_SECONDS=60

# ─────────────────────────────────────── testing only — never in production
#
# AUTH_SHOW_CODE=1 puts the credentials below on the login page so a tester can
# sign in without an inbox. Setting these on a deployment publishes a working
# account to anyone who opens the site.
AUTH_SHOW_CODE=
AUTH_TEST_EMAIL=
AUTH_TEST_PASSWORD=
